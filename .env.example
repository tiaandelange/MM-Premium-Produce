# Public site URL used for canonicals, Open Graph, sitemap and robots.
# Local: http://localhost:3000
# Vercel: set this to the live https:// domain, or leave it unset so Vercel
# supplies VERCEL_URL. Do not set this to localhost on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only on the production domain when the live catalogue is ready to be indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Neon PostgreSQL
DATABASE_URL=

# Admin CMS
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Payment provider is intentionally unconfigured until a provider is confirmed.
PAYMENT_PROVIDER=unconfigured
# PAYSTACK_SECRET_KEY=
# YOCO_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# --- Future integrations ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GOOGLE_MERCHANT_ID=
