# Public site URL used for canonicals, Open Graph, sitemap and robots.
# Local: http://localhost:3000
# Confirmed production origin on 19 Aug 2026 (Vercel production alias, no custom domain attached):
#   https://mm-premium-produce.vercel.app
# Set that exact HTTPS origin on the Vercel Production environment. Do not guess a
# branded domain. Do not set localhost on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only on the production domain when the live catalogue is ready to be indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Neon PostgreSQL
DATABASE_URL=

# Admin CMS
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Payment provider is intentionally unconfigured until a provider is confirmed.
PAYMENT_PROVIDER=unconfigured
# PAYSTACK_SECRET_KEY=
# YOCO_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

