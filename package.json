{
  "name": "mm-premium-produce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:push": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push --force",
    "db:report": "tsx scripts/build-migration-report.ts",
    "db:import": "tsx --env-file=.env.local scripts/import-catalog.ts",
    "db:rls": "tsx --env-file=.env.local scripts/apply-rls.ts",
    "db:i18n": "tsx --env-file=.env.local scripts/seed-i18n.ts",
    "db:editorial": "tsx --env-file=.env.local scripts/seed-editorial.ts",
    "seo:phase4b": "tsx --env-file=.env.local scripts/apply-phase4b-seo.ts",
    "seo:monthly": "tsx scripts/seo/monthly-growth.ts",
    "qa:smoke": "node scripts/qa-smoke-deploy.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
